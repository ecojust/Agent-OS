    classDef platform fill:#dcfce7,stroke:#16a34a,color:#14532d,stroke-width:2px;
    classDef device fill:#fff7ed,stroke:#ea580c,color:#7c2d12,stroke-width:2px;
    class launcher,controls,apps interface;
    class core,model,policy agentNode;
    class bridge,appbase,framework platform;
    class hal,kernel,hardware device;
