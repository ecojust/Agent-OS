flowchart TB
    user([用户]) --> ui

    subgraph phone[手机端]
        direction TB
        ui[对话与任务控制台<br/>模型配置 · 应用范围<br/>执行过程 · 暂停 / 停止]
        runtime[任务协调器<br/>状态机 · 执行预算<br/>取消 · 结果汇总]
        capabilities[设备兼容与能力探测<br/>系统版本 · 厂商行为<br/>可用工具与版本适配]
        gateway[模型网关<br/>协议适配 · 上下文裁剪<br/>请求取消]
        policy[执行控制层<br/>授权范围 · 用户确认<br/>锁屏与界面版本校验]
        tools[原子设备工具<br/>启动 · 观察 · 点击 · 输入<br/>手势 · 按需截图]
        observer[观察与结果验证<br/>范围过滤 · 数据脱敏<br/>最新界面版本]
        storage[(本机配置与诊断<br/>密钥库 · 加密配置<br/>最小化事件)]

        ui --> runtime
        runtime <--> gateway
        runtime --> capabilities --> policy --> tools
        ui --> storage
        gateway -. 读取认证配置 .-> storage

        subgraph adapters[平台适配层]
            direction LR
            publicapi[应用公开接口<br/>Intent / Deep Link]
            access[Android 执行适配器<br/>Accessibility · 受控手势]
            system[AOSP 系统适配器<br/>后续阶段：受控系统服务]
        end

        tools --> publicapi
        tools --> access
        tools -. 后续集成 .-> system
        apps[授权应用与系统能力]
        publicapi --> apps
        access --> apps
        system -. 经过平台权限检查 .-> apps
        apps --> observer --> runtime
    end

    gateway <-->|结构化请求与响应<br/>界面数据按授权披露| model[用户配置的模型服务<br/>服务地址 · API Key<br/>模型]

    classDef interaction fill:#e0f2fe,stroke:#0284c7,color:#0c4a6e,stroke-width:2px;
    classDef orchestration fill:#ede9fe,stroke:#7c3aed,color:#4c1d95,stroke-width:2px;
    classDef execution fill:#dcfce7,stroke:#16a34a,color:#14532d,stroke-width:2px;
    classDef future fill:#f8fafc,stroke:#64748b,color:#475569,stroke-width:2px,stroke-dasharray:5 5;
    classDef boundary fill:#fff7ed,stroke:#ea580c,color:#7c2d12,stroke-width:2px;
    class user,ui interaction;
    class runtime,capabilities,gateway,observer orchestration;
    class policy,tools,publicapi,access,apps execution;
    class system future;
    class model,storage boundary;
