  "checks": [
    {
      "id": "native-start-stop-cli",
      "result": "pass-source-contract",
      "sources": [
        "ActivityManagerShellCommand.java:1313-1432",
        "ActivityManagerService.java:16850-16917",
        "PackageManagerShellCommand.java:1016,1035,1172"
      ],
      "finding": "am profile start --user 0 PID PATH and am profile stop --user 0 PID are supported; regular/non-sampling/non-streaming flags are default. cmd package list packages -U --user 0 PACKAGE and package:NAME uid:N match the native parser/formatter. No unsupported check-permission subcommand is used."
    },
    {
      "id": "pidof-long-package",
      "result": "pass-upstream-contract-not-image-proof",
      "sources": [
        "toybox/toys/lsb/pidof.c:8-47",
        "toybox/lib/lib.c:1150-1212"
      ],
      "finding": "pidof NAME emits all matched PIDs and exits 0, or exits 1 without matches. Without -x, matching uses /proc/PID/cmdline basename, not truncated comm. Probe rejects zero/multiple PIDs and verifies exact cmdline, UID, start ticks separately. Toybox source is fixed at 59a869a838cfadbf6bc41cb400471ca9d2cae9b5 but not claimed to be the emulator image revision."
    },
    {
      "id": "complete-global-slot-admission",
      "result": "pass-source-contract",
      "sources": [
        "ProcessList.java:4675+",
        "ActivityManagerService.java:12199-12224",
        "AppProfiler.java:2496-2518",
        "ProcessRecord.java:1494-1530"
      ],
      "finding": "Unfiltered dumpsys activity -a processes requires exact header, boot-complete fields and terminal mForceBackgroundCheck. Empty slots are omitted in the fixed source. Any partial/foreign/duplicate profiling fields are rejected. Owned slot binds package, PID, UID label, unique path, four profile lines and all flags."
    },
    {
      "id": "native-fd-null-fix",
      "result": "resolved",
      "sources": [
        "AppProfiler.java:1973-2003",
        "AppProfiler.java:2508-2509"
      ],
      "finding": "After sending the duplicate FD to the target, AMS closes its original FD and stores null. Current parser requires mProfileFd=null for the complete owned slot; it does not confuse null FD with an empty global slot or with successful ART tracing."
    },
    {
      "id": "target-and-native-pid-binding",
      "result": "resolved",
      "finding": "Before start, package UID must equal all four actual /proc/PID/status UIDs; exact target cmdline and start ticks are bound. Recorded native summary PID must equal target PID in both producer completion and archive-side evidence validation."
    },
    {
      "id": "exact-owner-stop",
      "result": "pass-with-explicit-nonatomic-boundary",
      "sources": [
        "ActivityManagerService.java:16870-16917",
        "AppProfiler.java:1928-1942"
      ],
      "finding": "One stop is admitted only after fresh target stat/cmdline and exact owned global slot. The stop command rechecks start ticks, cmdline SHA-256 and four UIDs in the same remote shell immediately before exec am profile stop --user 0 PID. No bare global stop is used. AMS resolves the PID again and a vanished PID can resolve null, whose native meaning is global stop; residual service-side TOCTOU remains. Scope explicitly requires an exclusive synthetic AVD and states ownership checks are non-atomic."
    },
    {
      "id": "finally-and-failure-records",
      "result": "pass-with-bounded-observation",
      "finding": "Start intent and command receipts are written before side effects. Finally attempts owned cleanup even after failed/timeout start or a caught cancellation; unsafe owner/target states do not authorize stop. Original first failure is retained and cannot be promoted by a later parsed snapshot. A hard host kill may prevent finalization; missing artifact/archive status remains unverified."
    },
    {
      "id": "oversize-unstable-partial",
      "result": "resolved-with-explicit-size-command-limit",
      "finding": "When size commands succeed, oversize or unstable native files retain a bounded prefix <=16 MiB through RLIMIT_FSIZE; incomplete pull bytes remain originals and are unverified. After stop/owner failure before size polling, a separate read-only regular/non-link size check can preserve this run unique path without stop/delete or success promotion. Archive copies validated bytes exactly, including partial method.trace."
    },
    {
      "id": "size-command-failure-boundary",
      "result": "nonblocking-limitation",
      "code": [
        "scripts/ime_profile_probe.py:462",
        "scripts/ime_profile_probe.py:495"
      ],
      "finding": "If any size_poll_* was attempted and then polling fails/times out or produces malformed output, fallback returns without a second pull, even after an earlier successful regular-file size observation. Such paths preserve command receipts but do not guarantee binary preservation. This is a narrow failure-retention limitation, not a success-promotion or unsafe-stop issue; disclosed to root and capture owner before freeze."
    },
    {
      "id": "trusted-source-before-import",
      "result": "pass-logic-review",
      "finding": "Archive verifies same repo/manual master workflow, exact current run attempt/job/head, artifact ID/name/time/repo/size, and all five source-catalog Git blobs plus checkout bytes before compiling producer/parser. Executing Python resolution is checked and fresh compile from verified bytes avoids preloaded/stale pyc substitution. The archive runner itself is bound in the catalog."
    },
    {
      "id": "archive-originals-and-failure",
      "result": "pass-logic-review",
      "finding": "Only bounded regular report.json, commands.json and optional method.trace are accepted; links, noncanonical paths, unexpected files and changed originals are rejected. Payload is rescanned before publication. Failed/cancelled source or job cannot yield recorded archive status. Missing/expired artifact is an explicit unverified metadata-only manifest. Atomic rename and existing-destination/branch rejection prevent replacement."
    },
    {
      "id": "workflow-scope",
      "result": "pass-logic-review",
      "finding": "Probe is a short nonvisual capability check on a dedicated API37 AVD, with no APK installation, settings writes, root or UI stimulation. No original Notes/A-B run is implied. Always-upload preserves available failures; artifact absence remains explicitly represented. Fixed source controls syntax assumptions, while actual runtime commands and native parser gate future capability."
    }
  ],
