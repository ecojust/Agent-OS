  "findings": [
    {
      "id": "actual_admission",
      "source": [
        "ActivityManagerService.java:16850-16879",
        "ActivityManagerService.java:8332-8348",
        "Build.java:1903-1904",
        "packages/Shell/AndroidManifest.xml:187"
      ],
      "claim": "profileControl requires SET_ACTIVITY_WATCHER. setProfileApp skips app debug/profileable flags only if actual ro.debuggable==1. Build type userdebug alone is not the boolean. Shell declares the permission; actual run must check current grant. On ro.debuggable!=1, absent/unproved package flags remain unavailable. No root or flag/property mutation is required or authorized."
    },
    {
      "id": "global_slot_side_effect",
      "source": [
        "AppProfiler.java:1973-1984",
        "AppProfiler.java:1928-1959"
      ],
      "claim": "A start calls stopProfilerLPf(null) before target admission. Require a complete unfiltered global slot empty before start. This is an observed precondition, not atomic ownership or an assertion that directly app-started method tracing is universally discoverable."
    },
    {
      "id": "owned_slot",
      "source": [
        "AppProfiler.java:1978-2006",
        "AppProfiler.java:2045-2060",
        "AppProfiler.java:2495-2521",
        "ProcessRecord.java:1494-1546"
      ],
      "claim": "Numeric CLI PID is resolved to ProcessRecord; mProfileApp stores proc.processName, not the PID text. At normal start return the global profileFd has been closed and set null. Slot app/name, ProcessRecord PID/UID, unique profileFile and sampling0/streamingfalse/flags0/type0 must match. ProcessRecord hex identityHash is not a stable process identity. Same /proc PID/start time/UID must be rechecked before own stop; no global stop fallback."
    },
    {
      "id": "dump_completeness",
      "source": [
        "ActivityManagerService.java:11642-11652",
        "ProcessList.java:4675-4761",
        "ActivityManagerService.java:12181-12224"
      ],
      "claim": "processes invokes dumpAll=true; unfiltered dump starts with ACTIVITY MANAGER RUNNING PROCESSES (dumpsys activity processes), profile section is in dumpOtherProcessesInfoLSP, and its final mForceBackgroundCheck boolean follows Total persistent processes/mProcessesReady/mBooting. Empty global slot produces no profile lines, not a null status row. Package filtering can hide another owner and cannot be used for empty-slot admission."
    },
    {
      "id": "request_not_runtime_ack",
      "source": [
        "ActivityManagerShellCommand.java:1313-1432",
        "ActivityThread.java:1692",
        "ActivityThread.java:1109-1130",
        "ActivityThread.java:7632-7684"
      ],
      "claim": "start/stop dispatch asynchronously to ActivityThread. Native runtime exceptions are logged rather than returned through command exit. Exit0 and AMS slot only prove request/server state; require actual bounded original complete native file and matching PID plus source command receipts."
    },
    {
      "id": "buffer_not_total_limit",
      "source": [
        "ActivityThread.java:1116-1119",
        "runtime/trace.cc:1100-1204"
      ],
      "claim": "SystemProperties.getInt(debug.traceview-buffer-size-mb,8) controls binary buffer. Read without mutation; empty means default8. Unsupported property lexical values may conservatively fail admission. Text summary/symbol tables are additional, so MAX_TRACE_BYTES16MiB is a distinct total-file/host parser limit, not an on-device allocation bound. ART64 reference buffer pool additionally costs approximately128MiB; no measured device memory claim."
    },
    {
      "id": "exact_supported_format",
      "source": [
        "runtime/trace.cc:1004-1048",
        "runtime/trace.cc:1100-1148",
        "runtime/trace.cc:1347-1349",
        "runtime/trace.cc:1940-1989",
        "runtime/trace_common.h:44-50",
        "runtime/trace.h:394"
      ],
      "claim": "Support modern ART V1 nonstreaming on-disk2(single-clock10B) or3(dual14B), 32B SLOW little-endian header. Fixed method rows have exactly5 fields including ID, with no source line number. Method encoding begins0 and native printf spells it 0; thread encodings begin1 and are not Linux TIDs. Unsupported6-field/streaming/new packet formats remain unverified."
    },
    {
      "id": "format_integrity_not_stack",
      "claim": "Validate complete bounded summary, unique numeric dictionaries, resolved record references, count and framing, actions0/1/2, PID, clock/version/header/reserved bytes, finite unsigned counters and per-thread clock order. No stack balance or caller classification is attempted: boundary exits/unwinds and open frames are permitted. is_precise_trace is not sampling admission; commands must establish sampling0. Count is event-record count, not method invocation count. No absence or future8s-window coverage inference."
    },
    {
      "id": "runtime_intrusion_and_time",
      "source": [
        "runtime/trace.cc:700-786",
        "runtime/instrumentation.cc:1402-1427",
        "runtime/trace.cc:1004-1030",
        "libartbase/base/time_utils.cc:179-189"
      ],
      "claim": "Non-sampling profiling suspends threads/JIT, invalidates code and deoptimizes; stop may return runtime to nondebuggable but does not restore previous JIT/cache history. It is a separate disposable-device observation, not unchanged timing/performance. MONOTONIC/thread-CPU clocks are not mapped to BOOTTIME by this parser."
    }
  ],
  "parserContract": {
    "entrypoint": "parse_trace(data: bytes) -> dict",
    "status": [
      "recorded",
      "unverified"
    ],
    "limits": {
      "traceBytes": 16777216,
